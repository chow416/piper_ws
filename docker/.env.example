# =============================================================================
#  复制成 .env 后按需修改：cp .env.example .env
#
#  .env 只影响 **构建镜像** 时用哪套源，以及容器以什么 UID 运行。
#  构建参数一旦变了，必须 --build 重新构建才会生效。
# =============================================================================

# --- 换源（国内默认清华；海外同事改成官方源） ---------------------------------
UBUNTU_MIRROR=mirrors.tuna.tsinghua.edu.cn
ROS2_MIRROR=mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
ROSDISTRO_MIRROR=mirrors.tuna.tsinghua.edu.cn/rosdistro
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 海外版（取消注释，同时注释掉上面四行）
# UBUNTU_MIRROR=archive.ubuntu.com
# ROS2_MIRROR=packages.ros.org/ros2/ubuntu
# ROSDISTRO_MIRROR=raw.githubusercontent.com/ros/rosdistro/master
# PIP_INDEX=https://pypi.org/simple

# --- 容器内 Mesa 是否升级到 25.x ----------------------------------------------
# 1 = 加 kisak/kisak-mesa PPA（新款 Intel 核显想拿到硬件加速时用）
# 0 = 用 22.04 自带的 Mesa 22.0.1（软件渲染，功能完整）
ENABLE_MESA_PPA=0

# --- 以宿主当前用户的 UID/GID 构建，避免工作区产出 root 属主的文件 -------------
# 多数单用户桌面就是 1000。查自己的：id -u / id -g
# 注意：改这里之后必须 --build 重建镜像，光 restart 不生效。
USER_UID=1000
USER_GID=1000

# --- 运行期 -------------------------------------------------------------------
DISPLAY=:0
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 想强制软件渲染排查显卡问题时设 1
LIBGL_ALWAYS_SOFTWARE=0

# 关掉进入容器时的自检横幅
PIPER_QUIET=0
