# CPU-only training layer; the running ROS/Gazebo image is not modified.
FROM piper-dev:humble
USER root
RUN python3 -m venv /opt/button-venv
ENV PATH=/opt/button-venv/bin:$PATH \
    PYTHONPATH=/ws/src/Piper_ros/src/piper_button_perception \
    TORCH_HOME=/ws/models/torch-cache \
    PYTHONUNBUFFERED=1
COPY requirements-training.txt /tmp/requirements-training.txt
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements-training.txt
USER dev
WORKDIR /ws
ENTRYPOINT ["/opt/button-venv/bin/python", "-m", "piper_button_perception.train_detector"]
